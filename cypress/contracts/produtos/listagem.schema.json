{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contratos.serverest.local/produtos/listagem.schema.json",
  "title": "GET /produtos (200)",
  "type": "object",
  "required": ["quantidade", "produtos"],
  "additionalProperties": false,
  "properties": {
    "quantidade": { "$ref": "../definicoes.schema.json#/$defs/inteiroNaoNegativo" },
    "produtos": {
      "type": "array",
      "items": { "$ref": "../definicoes.schema.json#/$defs/produto" }
    }
  }
}
