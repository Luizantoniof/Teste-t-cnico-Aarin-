{
  "stepDefinitions": ["cypress/support/step_definitions/**/*.js"],
  "filterSpecs": true,
  "omitFiltered": true,
  "messages": {
    "enabled": true,
    "output": "reports/cucumber/cucumber-messages.ndjson"
  },
  "json": {
    "enabled": true,
    "output": "reports/cucumber/cucumber-report.json"
  },
  "html": {
    "enabled": true,
    "output": "reports/cucumber/cucumber-report.html"
  }
}
